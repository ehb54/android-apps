+    def _load_voice(self, voice: str) -> dict:
+        """Load a pre-encoded upstream voice (.pt with "acoustic_mean").
+
+        voice is a name from the model's voices/ folder ("default", "clear",
+        ...) or a path to a .pt file. Reading .pt files needs torch.
+        """
+        path = Path(voice)
+        if not path.is_file():
+            path = Path(self.model_path) / "voices" / f"{voice}.pt"
+        if not path.is_file():
+            raise FileNotFoundError(
+                f"voice {voice!r}: no {path}; download voices/{voice}.pt from "
+                "the model repo first"
+            )
+        import torch
 
+        cache = torch.load(path, map_location="cpu", weights_only=True)
+        if "acoustic_mean" not in cache:
+            raise ValueError(f"{path}: no acoustic_mean (keys {list(cache)})")
+        mean = cache["acoustic_mean"].float().numpy()
+        if mean.ndim == 2:
+            mean = mean[None]
+        std = cache.get("acoustic_std")
+        std = float(std) if std is not None else self.acoustic_tokenizer.fix_std
+        return {"acoustic_mean": mx.array(mean), "acoustic_std": std}
+
+    def _voice_embeds(self, voice_cache: dict) -> mx.array:
+        """Voice frames as LM input embeddings, (1, N, hidden), as upstream's
+        _process_speech_inputs: sample around the mean, scale, connect."""
+        mean = voice_cache["acoustic_mean"]
+        features = mean + voice_cache["acoustic_std"] * mx.random.normal(mean.shape)
+        if not mx.isnan(self.speech_scaling_factor).item():
+            features = (
+                features + self.speech_bias_factor
+            ) * self.speech_scaling_factor
+        dtype = self.language_model.embed_tokens.weight.dtype
+        return self.acoustic_connector(features.astype(dtype)).astype(dtype)
